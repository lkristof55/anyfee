{
  "name": "@anyfee/attester",
  "version": "0.1.0",
  "private": true,
  "description": "anyfee attester: verifies GitHub Actions OIDC tokens and X posts, signs bind attestations (it can bind a vault, never withdraw).",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "oidc-selftest": "node scripts/oidc-selftest.ts",
    "localnet-e2e": "node scripts/localnet-e2e.ts"
  },
  "dependencies": {
    "@anyfee/sdk": "0.1.0",
    "@noble/curves": "^2.4.0",
    "@solana/web3.js": "^1.99.0",
    "bs58": "^6.0.0"
  }
}
